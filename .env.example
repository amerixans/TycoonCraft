# Copy to .env on the droplet and edit. Never commit .env -- the deploy runs
# `git reset --hard`, and a tracked .env would wipe your port and subpath on
# every push.

# Subpath the game is mounted at, e.g. /tycooncraft. Empty serves at the
# domain root. On the droplet, add-app.sh writes this for you.
BASE_PATH=

# Local port nginx proxies to, bound to 127.0.0.1 only. add-app.sh allocates
# this -- do not pick one by hand.
HOST_PORT=8080

# Names new discoveries. THE GAME RUNS WITHOUT THIS: with no key set, items
# get deterministic fallback names built from their traits and /health reports
# {"llm": "unconfigured"}. Set it to get invented names.
#   https://console.anthropic.com  ->  Create Key
ANTHROPIC_API_KEY=

# Signs the resume cookie. Leave blank and one is generated into DATA_DIR on
# first boot, which is what you want -- a fixed value here would be shared
# across rebuilds.
SECRET_KEY=
