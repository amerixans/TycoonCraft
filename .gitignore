# .env is written by add-app.sh on the droplet and holds the port, the subpath
# and the API key. The deploy runs `git reset --hard`, so tracking it would
# wipe all three on every push.
#
# Note the absence of `.env.*` here: that pattern would also exclude
# .env.example, which the platform contract requires to be committed.
.env
secret.key
*.pem
*.key

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# SQLite lives in a docker volume in production; this is the local-dev path.
data/

.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
